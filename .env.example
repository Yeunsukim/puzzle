# 이 파일을 복사해서 이름을 ".env" 로 바꾼 뒤, 아래 따옴표 없이 값을 넣으세요.
# 자세한 방법: 구글로그인_설정방법.md

# 구글 로그인용 '클라이언트 ID' (구글 클라우드에서 발급, ...apps.googleusercontent.com 으로 끝남)
GOOGLE_CLIENT_ID=

# 서버가 쓸 문 번호 (보통 바꿀 필요 없음)
PORT=3000

# Supabase 연결 주소. 비워 두면 내 컴퓨터(data/puzzle.db)에 저장해요.
# 넣으면 내 컴퓨터에서 켜도 인터넷 서버와 같은 데이터를 써요. (방법: 인터넷에_올리는_방법.md)
DATABASE_URL=
